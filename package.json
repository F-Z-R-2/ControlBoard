{
  "name": "controlboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:schema": "node --env-file-if-exists=.env --import tsx scripts/apply-schema.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/apply-migrations.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx db/seed.ts",
    "test:roles": "node --import tsx --test tests/roles.test.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts",
    "test:attendance": "node --import tsx --test tests/attendance.test.ts",
    "test:academics": "node --import tsx --test tests/academics.test.ts",
    "test:grading": "node --import tsx --test tests/grading.test.ts",
    "test:psychology": "node --import tsx --test tests/psychology.test.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "livekit-client": "^2.24.0",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
